# ===== Server =====
# The port the server listens on
PORT=3000
# Environment: development | production
NODE_ENV=development

# ===== Authentication (JWT) =====
# Secret used to sign JWT tokens — CHANGE THIS to a long random string in real use
JWT_SECRET=change_me_to_a_long_random_secret
# How long a login token stays valid (e.g. 1h, 12h, 7d)
JWT_EXPIRES_IN=12h

# ===== Database (SQLite) =====
# Path to the SQLite database file (relative to the project root)
DB_STORAGE=./database.sqlite

# ===== Initial admin (used by the seed script) =====
SEED_ADMIN_USERNAME=Avraham
SEED_ADMIN_EMAIL=admin@restaurant.local
SEED_ADMIN_PASSWORD=avigail
